# ============================================
# Wishlist - Git Ignore
# ============================================

# Environment variables / secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# Node / Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# IDE / editor
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.temp
# Legacy local product data
backend/products.json

# Legacy local product data
backend/products.json
