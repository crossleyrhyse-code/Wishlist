# ============================================
# Wishlist - Git Ignore
# ============================================

# Environment variables / secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# Node / Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
venv/
.venv/
backend/venv/
backend/.venv/

# IDE / editor
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Logs / temporary files
*.log
*.tmp
*.temp

# Local runtime data
backend/products.json
backend/comparison_cache.json
backend/settings.json

# One-off retailer discovery/debug artefacts
backend/jbhifi_search_debug.html
backend/comparison_v2.zip
backend/comparison_v2/tests/live/kmart_capture_output.json
